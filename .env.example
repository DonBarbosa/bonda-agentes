# =====================================================================
# BONDA OS — Invoice Watcher — Environment Variables
# =====================================================================
# Copy this file to .env (or append the lines to your existing .env)
# and fill in the values. Do NOT commit the real .env to version control.
# =====================================================================

# --- Gmail credentials (REQUIRED) ------------------------------------
# The Gmail account whose inbox we watch. Must be the same account that
# generates the App Password below.
BONDA_GMAIL_USER=rogeradrian@gmail.com

# Generate at:
#   https://myaccount.google.com → Security → 2-Step Verification → App passwords
# Choose "Mail" as the app and "Other (custom name)" → name it "BONDA OS Invoice Watcher".
# Google will show 16 chars in 4 groups, e.g. "abcd efgh ijkl mnop".
# You can paste with or without spaces — the client sanitizes both.
BONDA_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Forward target (OPTIONAL — default shown) -----------------------
BONDA_FACTURACION_EMAIL=facturacion@steviabonda.com.mx

# --- BONDA fiscal data (OPTIONAL — defaults shown, please verify) ----
# These get pasted into the body of every forwarded email so the
# counterpart knows how to issue the CFDI.
BONDA_FISCAL_NAME=BONDA ALIMENTOS SANOS
BONDA_FISCAL_RFC=BAS2112142V6
BONDA_FISCAL_ADDRESS=Encino #1385-A, Col. del Fresno, Guadalajara, Jalisco, México

# Roger: fill these two — currently empty so the body shows "pendiente confirmar"
BONDA_FISCAL_CP=
BONDA_FISCAL_REGIME=

BONDA_FISCAL_CFDI_USE=G03

# --- Logging (OPTIONAL) ----------------------------------------------
# Default: ~/.bonda/logs
# BONDA_LOG_DIR=/home/roger/.bonda/logs
